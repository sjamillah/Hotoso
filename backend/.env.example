DJANGO_ALLOWED_HOSTS=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Read by the postgres image on its first start only (names are fixed by the image)
POSTGRES_DB=hotoso
POSTGRES_USER=hotoso
POSTGRES_PASSWORD=change-me

# Same user, password and db as above. Host is localhost when Django runs on your machine.
DATABASE_URL=postgres://hotoso:change-me@localhost:5432/hotoso
