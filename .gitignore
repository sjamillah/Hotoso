# Project-wide ignores. frontend/.gitignore adds the Next.js-specific ones.

# ---- secrets: NEVER committed (CLAUDE.md rule 6) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python / Django (backend, from M0) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
backend/staticfiles/
backend/media/
*.sqlite3

# ---- Node (if anything is installed outside frontend/) ----
node_modules/

# ---- editors and operating systems ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code: personal settings stay on this laptop ----
.claude/settings.local.json
